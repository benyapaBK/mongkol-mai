rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role == "member";
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /plants/{plantId} {
      // Admin และ Member อ่าน/ค้นหา/ส่งออกได้
      allow read: if signedIn();
      // เพิ่ม/แก้ไข/ลบข้อมูลหลักเฉพาะ Admin
      // Admin แก้ข้อมูลของผู้ใช้คนอื่นได้ด้วย ไม่มีเงื่อนไข createdBy
      allow create, update, delete: if isAdmin();
    }

    match /counters/{counterId} {
      // Counters เป็นข้อมูลควบคุมฐานข้อมูล ไม่เปิดให้ Member แก้ไข
      allow read, write: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /plantVersions/{versionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
                    && request.resource.data.changedBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /drafts/{draftId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /deletionRequests/{requestId} {
      allow read: if signedIn()
                  && (isAdmin()
                      || resource.data.requestedBy == request.auth.uid
                      || resource.data.plantOwnerId == request.auth.uid);
      allow create: if isAdmin()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == "pending_owner_review";
      allow update: if signedIn()
                    && resource.data.plantOwnerId == request.auth.uid
                    && request.resource.data.plantOwnerId == resource.data.plantOwnerId
                    && request.resource.data.requestedBy == resource.data.requestedBy
                    && request.resource.data.status in ["approved", "declined"];
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
