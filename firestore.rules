rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================
    // AUTHENTICATION
    // =========================================

    function signedIn() {
      return request.auth != null;
    }

    // ตรวจว่าเป็น Admin
    function isAdmin() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }


    // =========================================
    // USERS
    // =========================================

    match /users/{uid} {

      // -----------------------------------------
      // ดูข้อมูลสมาชิก
      // -----------------------------------------

      // สมาชิกดูข้อมูลตัวเองได้
      // Admin ดูข้อมูลสมาชิกทุกคนได้
      allow read: if signedIn()
                  && (
                    request.auth.uid == uid
                    || isAdmin()
                  );


      // -----------------------------------------
      // สร้างสมาชิก
      // -----------------------------------------

      // ผู้สมัครสร้างได้เฉพาะข้อมูลของตัวเอง
      // และ role ต้องเป็น member เท่านั้น
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == "member";


      // -----------------------------------------
      // แก้ไขข้อมูลสมาชิก
      // -----------------------------------------

      // สมาชิกแก้ข้อมูลตัวเองได้
      // แต่ห้ามเปลี่ยน role
      allow update: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;


      // Admin แก้ข้อมูลสมาชิกได้
      allow update: if isAdmin();


      // -----------------------------------------
      // ลบสมาชิก
      // -----------------------------------------

      // เฉพาะ Admin
      allow delete: if isAdmin();
    }


    // =========================================
    // PLANTS
    // =========================================

    match /plants/{plantId} {

      // -----------------------------------------
      // ดู / ค้นหา / Export
      // -----------------------------------------

      // Admin และ Member ดูข้อมูลได้
      allow read: if signedIn();


      // -----------------------------------------
      // เพิ่มข้อมูลพืช
      // -----------------------------------------

      // เฉพาะ Admin
      allow create: if isAdmin();


      // -----------------------------------------
      // แก้ไขข้อมูลพืช
      // -----------------------------------------

      // เฉพาะ Admin
      allow update: if isAdmin();


      // -----------------------------------------
      // ลบข้อมูลพืช
      // -----------------------------------------

      // เฉพาะ Admin
      allow delete: if isAdmin();
    }


    // =========================================
    // COUNTERS
    // =========================================

    match /counters/{counterId} {

      // Admin เท่านั้น
      allow read, write: if isAdmin();
    }


    // =========================================
    // ACTIVITY LOGS
    // =========================================

    match /activityLogs/{logId} {

      // เฉพาะ Admin ดูได้
      allow read: if isAdmin();

      // ไม่อนุญาตให้ผู้ใช้ทั่วไปสร้างเอง
      allow create: if isAdmin();

      // ห้ามแก้ไข
      allow update: if false;

      // ห้ามลบ
      allow delete: if false;
    }





    // =========================================
    // PLANT VERSION HISTORY
    // =========================================
    match /plantVersions/{versionId} {
      // เฉพาะ Admin ดูประวัติรุ่นข้อมูลได้
      allow read: if isAdmin();

      // เฉพาะ Admin สร้าง Version snapshot
      allow create: if isAdmin()
                    && request.resource.data.changedBy == request.auth.uid;

      // ห้ามแก้/ลบ Version เพื่อรักษาประวัติ
      allow update, delete: if false;
    }

    // =========================================
    // SAVED DRAFTS / BACKUPS
    // =========================================

    match /drafts/{draftId} {
      // แต่ละบัญชีเห็นเฉพาะข้อมูลสำรองของตัวเอง
      allow read: if signedIn()
                  && resource.data.userId == request.auth.uid;

      // สร้างได้เฉพาะแบบร่างที่เป็นของผู้สร้างเอง
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;

      // แก้ไข/อัปเดตได้เฉพาะเจ้าของ
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      // ลบได้เฉพาะเจ้าของ
      allow delete: if signedIn()
                    && resource.data.userId == request.auth.uid;
    }


    // =========================================
    // DELETION REQUESTS
    // =========================================
    match /deletionRequests/{requestId} {
      // Admin/ผู้ขอ และเจ้าของข้อมูลอ่านคำขอที่เกี่ยวข้องได้
      allow read: if signedIn()
                  && (
                    isAdmin()
                    || resource.data.requestedBy == request.auth.uid
                    || resource.data.plantOwnerId == request.auth.uid
                  );

      // เฉพาะ Admin ส่งคำขอลบข้อมูลของผู้อื่น
      allow create: if isAdmin()
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == "pending_owner_review";

      // เจ้าของข้อมูลเปลี่ยนสถานะได้เฉพาะ approved/declined
      allow update: if signedIn()
                    && resource.data.plantOwnerId == request.auth.uid
                    && request.resource.data.plantOwnerId == resource.data.plantOwnerId
                    && request.resource.data.requestedBy == resource.data.requestedBy
                    && request.resource.data.status in ["approved","declined"];

      // ไม่อนุญาตให้ลบคำขอ เพื่อเก็บหลักฐานการร้องขอ
      allow delete: if false;
    }

    // =========================================
    // DEFAULT DENY
    // =========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}